# --- Credenciales (obligatorias) ---
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
PG_URI=postgresql+psycopg2://postgres:postgres@localhost:5432/dw_universidad

# --- Escenario de ejecucion (opcional: estos son los valores por defecto) ---
# Cambiando estas tres variables se corre el pipeline sobre otro dataset y otras
# bases, sin tocar una linea de codigo. Ejemplo: escenario v2 (dataset ampliado).
MONGO_DB=Estudiantes
PG_DB=dw_universidad
DATASET_CSV=data/dataset_estudiantes_etl.csv
